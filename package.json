{
  "name": "pdimpression",
  "version": "0.1.0",
  "private": true,
  "description": "Offline film contact sheets for photographic labs",
  "author": "PD Impression",
  "main": "out/main/index.js",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "predev": "npm run icons",
    "prebuild": "npm run icons",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:desktop": "tsx scripts/desktop-smoke.ts",
    "test:workspace": "tsx scripts/workspace-smoke.ts",
    "test:multitask": "tsx scripts/multitask-smoke.ts",
    "test:export-name": "tsx scripts/export-name-smoke.ts",
    "test:scan-types": "tsx scripts/scan-types-smoke.ts",
    "test:packaged": "tsx scripts/packaged-smoke.mts",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run dist:mac:intel",
    "dist:mac:intel": "npm run build && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --config electron-builder.arm64.cjs --mac dmg --arm64 --publish never",
    "verify:mac:intel": "node scripts/verify-mac-intel.mjs",
    "verify:mac:arm64": "node scripts/verify-mac-arm64.mjs"
  },
  "build": {
    "appId": "studio.pdimpression.desktop",
    "productName": "PD Impression",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64"] }],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "13.7.1",
      "artifactName": "${productName}-${version}-macOS-Intel.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "category": "public.app-category.photography"
    }
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
